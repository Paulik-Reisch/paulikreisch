rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Hilfsfunktion, um zu prüfen, ob ein Benutzer angemeldet ist.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verschachtelte Regel für die /CHIPIRONES/music/tracks Collection
    match /CHIPIRONES/music/tracks/{trackId} {
      
      // JEDER darf einzelne Tracks lesen (get) und die gesamte Liste abfragen (list).
      // 'list' muss auf der Collection-Ebene definiert werden, aber kann hier für Klarheit wiederholt werden.
      allow read: if true;
      
      // NUR angemeldete Benutzer dürfen Tracks erstellen, bearbeiten oder löschen.
      allow write: if isSignedIn();
    }
    
    // Explizite Regel für die LIST-Operation auf der Collection.
    // Dies ist der entscheidende Teil, der gefehlt hat.
    match /CHIPIRONES/music/tracks {
        allow list: if true;
    }
  }
}
