rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Hilfsfunktion
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Tracks können von JEDEM gelesen/aufgelistet werden.
    match /CHIPIRONES/music/tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Diese Regel ist entscheidend und hat gefehlt:
    // Erlaube jedem, die gesamte Sammlung aufzulisten.
    match /CHIPIRONES/music/tracks {
        allow list: if true;
    }
    
  }
}
