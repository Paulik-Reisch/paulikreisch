rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Erlaubt Lesezugriff auf 'tracks' für jeden authentifizierten Nutzer
    match /CHIPIRONES/music/tracks/{trackId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Optional: Nur wenn User auch schreiben dürfen
    }

    // Explizite Regel für die LIST-Operation auf der Collection.
    match /CHIPIRONES/music/tracks {
        allow list: if request.auth != null;
    }
  }
}
