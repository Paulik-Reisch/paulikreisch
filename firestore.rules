rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Allow public read access to the tracks collection for the music player,
    // but restrict write access. In a real app, write would be limited to admins.
    match /CHIPIRONES/music/tracks/{trackId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // In a real app, you'd check for an admin claim here.
    }
    
    // Deny all other access by default
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
