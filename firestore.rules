rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'maximilian.reisch@t-online.de',
          'philipp.l.paulik@gmail.com'
        ];
    }

    function isWorthaftWord(word) {
      return word is string
        && word.size() == 5
        && word.matches('^[A-Za-zÄÖÜäöüßẞ]{5}$');
    }

    function isWorthaftDate(date) {
      return date is string
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- Oeffentliche Lese-Collections (unauthentifizierte Website-Zugriffe,
    // Client-SDK im Browser oder serverseitig ohne Auth) ---

    // Autorenseiten /autoren + /autoren/[slug]
    match /authors/{id} {
      allow read: if true;
    }

    // Leseproben /leseprobe
    match /excerpts/{id} {
      allow read: if true;
    }

    // Rechtsseiten (Impressum, Datenschutz, AGB ...) + sitemap.xml
    match /legal/{id} {
      allow read: if true;
    }

    // Oeffentliche Landingpages /lp/[slug]
    match /landing_pages/{id} {
      allow read: if true;
    }

    // Oeffentliche Satire-Inhalte auf den Landingpages
    match /palabrotas/{id} {
      allow read: if true;
    }

    match /chistes/{id} {
      allow read: if true;
    }

    // SEO-Metadaten, serverseitig beim Rendern oeffentlicher Seiten gelesen
    match /seo_metadata/{id} {
      allow read: if true;
    }

    // Worthaft-Wortlisten (Spiel laedt sie clientseitig, unauthentifiziert)
    match /worthaft-words/{id} {
      allow read: if true;
    }

    match /worthaft-anti-words/{id} {
      allow read: if true;
    }

    // Worthaft-Feedback: Anlegen oeffentlich mit strenger Validierung
    // (unveraendert aus den bisherigen Regeln), Lesen nur Admin.
    match /worthaft-feedback/{feedbackId} {
      allow read: if isAuthorizedAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['word', 'vote', 'reasons', 'date', 'createdAt'])
        && request.resource.data.keys().hasAll(['word', 'vote', 'reasons', 'date', 'createdAt'])
        && isWorthaftWord(request.resource.data.word)
        && request.resource.data.vote in ['up', 'down']
        && request.resource.data.reasons is list
        && request.resource.data.reasons.size() <= 9
        && request.resource.data.reasons.hasOnly([
          'ist kein (deutsches) Wort.',
          'ist zu schwer.',
          'ist zu leicht.',
          'ist ein Eigenname.',
          'ist veraltet.',
          'ist vulgär oder unangemessen.',
          'ist zu speziell / ein Fachbegriff.',
          'hat eine uneindeutige Schreibweise.',
          'steht im Plural.'
        ])
        && (request.resource.data.vote == 'up'
          ? request.resource.data.reasons.size() == 0
          : request.resource.data.reasons.size() > 0)
        && isWorthaftDate(request.resource.data.date)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAuthorizedAdmin();
    }

    match /worthaft-word-suggestions/{suggestionId} {
      allow read: if isAuthorizedAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['word', 'shouldExist', 'date', 'createdAt'])
        && request.resource.data.keys().hasAll(['word', 'shouldExist', 'date', 'createdAt'])
        && isWorthaftWord(request.resource.data.word)
        && request.resource.data.shouldExist is bool
        && isWorthaftDate(request.resource.data.date)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAuthorizedAdmin();
    }

    // Newsletter-Anmeldung: Server Action nutzt das Client-SDK ohne Auth.
    // Anlegen oeffentlich mit Validierung, Lesen/Aendern nur Admin.
    // HINWEIS FUER REVIEW: Verhaltensaenderung - heute scheitert ein
    // anonymer Write hier (write nur Admin). Siehe PR-Beschreibung.
    match /subscribers/{id} {
      allow read, update, delete: if isAuthorizedAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 100;
    }

    // --- Fangnetz: alles andere nur noch fuer verifizierte Allowlist-Admins ---
    // Deckt u.a. ab: settings (inkl. settings/admin), orders, logs, newsletters,
    // campaigns, analytics_events und jede kuenftig neue Collection.
    match /{document=**} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
