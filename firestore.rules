rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Allow public read access to the tracks collection for the music player,
    // but restrict write access to signed-in users (admins).
    match /CHIPIRONES/music/tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Deny all other access by default
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
