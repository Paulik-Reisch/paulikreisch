rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Allow public read access to individual tracks
    match /CHIPIRONES/music/tracks/{trackId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Allow public list access to the entire collection
    match /CHIPIRONES/music/tracks {
      allow list: if true;
    }
  }
}
