
{
  "entities": {
    "Track": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Track",
      "type": "object",
      "description": "Represents a music track managed within the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the track."
        },
        "title": {
          "type": "string",
          "description": "Title of the track."
        },
        "artist": {
          "type": "string",
          "description": "Artist of the track."
        },
        "duration": {
          "type": "string",
          "description": "Duration of the track in M:SS format."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL for the track's cover image.",
          "format": "uri"
        },
        "audioUrl": {
          "type": "string",
          "description": "URL for the track's audio file.",
          "format": "uri"
        },
        "album": {
          "type": "string",
          "description": "Album the track belongs to."
        },
        "vibe": {
          "type": "string",
          "description": "The vibe or playlist category for the track.",
          "enum": ["Chipirón Selects", "Bavarian Beats", "Fiesta Latino", "Russian Lo-Fi"]
        },
        "lyrics": {
            "type": "array",
            "description": "Array of lyric objects with time and text.",
            "items": {
                "type": "object",
                "properties": {
                    "time": { "type": "number", "description": "Time in seconds" },
                    "text": { "type": "string", "description": "Lyric line" }
                },
                "required": ["time", "text"]
            }
        }
      },
      "required": [
        "title",
        "artist",
        "duration",
        "imageUrl",
        "audioUrl",
        "album",
        "vibe"
      ]
    },
    "Article": {
      "title": "Article",
      "type": "object",
      "description": "A satirical article for the premium section.",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageAlt": { "type": "string" },
        "teaser": { "type": "string" },
        "content": { "type": "string" },
        "readTime": { "type": "number", "description": "Reading time in minutes" },
        "publishedDate": { "type": "string", "format": "date-time" },
        "accessLevel": {
          "type": "string",
          "description": "Controls the access level for the article.",
          "enum": ["free", "leadwall", "sharewall"]
        },
        "author": {
          "type": "string",
          "description": "Art des Autors, z.B. Redaktion oder Gastbeitrag.",
          "enum": ["redaktion", "gastbeitrag"]
        },
        "status": {
          "type": "string",
          "description": "The publication status of the article.",
          "enum": ["draft", "published"]
        }
      },
      "required": ["title", "slug", "category", "imageUrl", "teaser", "content", "readTime", "publishedDate", "accessLevel", "status"]
    },
    "Author": {
      "title": "Author",
      "type": "object",
      "description": "Represents an author of articles.",
      "properties": {
        "slug": { "type": "string", "description": "URL-friendly identifier for the author." },
        "firstName": { "type": "string", "description": "The author's first name." },
        "lastName": { "type": "string", "description": "The author's last name." },
        "profilePictureUrl": { "type": "string", "format": "uri", "description": "URL for the author's profile picture." },
        "bio": { "type": "string", "description": "A short biography of the author." },
        "websiteUrl": { "type": "string", "format": "uri", "description": "A personal or professional website URL for backlinking." }
      },
      "required": ["slug", "firstName", "lastName", "profilePictureUrl", "bio"]
    },
    "LandingPage": {
      "title": "Landing Page",
      "type": "object",
      "description": "A standalone landing page with custom HTML, CSS, and JS.",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "htmlContent": { "type": "string" },
        "cssContent": { "type": "string" },
        "jsContent": { "type": "string" }
      },
      "required": ["slug", "title"]
    },
    "AnalyticsEvent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Analytics Event",
      "type": "object",
      "description": "Represents a single tracked event in the application.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "Type of the event, e.g., 'page_view', 'newsletter_subscription'." },
        "timestamp": { "type": "string", "format": "date-time" },
        "path": { "type": "string", "description": "The URL path where the event occurred." },
        "userId": { "type": "string", "description": "The authenticated or anonymous user ID." },
        "params": {
          "type": "object",
          "description": "Additional parameters for the event, like UTM tags.",
          "properties": {
            "utm_source": { "type": "string" },
            "utm_medium": { "type": "string" },
            "utm_campaign": { "type": "string" },
            "utm_content": { "type": "string" },
            "utm_term": { "type": "string" },
            "source": { "type": "string" }
          }
        }
      },
      "required": ["type", "timestamp", "path", "userId"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "type": "object",
      "description": "Represents a user who subscribed to the newsletter.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The subscriber's email address."
        },
        "source": {
          "type": "string",
          "description": "The source from where the subscription originated (e.g., 'footer', 'leadwall')."
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user subscribed."
        }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/CHIPIRONES/music/tracks/{trackId}": {
      "schema": {
        "$ref": "#/entities/Track"
      },
      "description": "Collection of music tracks. Accessible only to authenticated admins for management."
    },
    "/articles/{articleId}": {
      "schema": {
        "$ref": "#/entities/Article"
      },
      "description": "Collection of premium satire articles."
    },
     "/authors/{authorId}": {
      "schema": {
        "$ref": "#/entities/Author"
      },
      "description": "Collection of author profiles."
    },
    "/landing_pages/{lpId}": {
      "schema": {
        "$ref": "#/entities/LandingPage"
      },
      "description": "Collection of standalone landing pages."
    },
    "/analytics_events/{eventId}": {
        "schema": {
            "$ref": "#/entities/AnalyticsEvent"
        },
        "description": "Collection of analytics events for internal tracking."
    },
    "/subscribers/{subscriberId}": {
        "schema": {
            "$ref": "#/entities/Subscriber"
        },
        "description": "Collection of newsletter subscribers, as a fallback."
    }
  }
}
