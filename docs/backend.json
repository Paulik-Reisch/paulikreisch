{
  "entities": {
    "Track": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Track",
      "type": "object",
      "description": "Represents a music track managed within the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the track."
        },
        "title": {
          "type": "string",
          "description": "Title of the track."
        },
        "artist": {
          "type": "string",
          "description": "Artist of the track."
        },
        "duration": {
          "type": "string",
          "description": "Duration of the track in M:SS format."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL for the track's cover image.",
          "format": "uri"
        },
        "audioUrl": {
          "type": "string",
          "description": "URL for the track's audio file.",
          "format": "uri"
        },
        "album": {
          "type": "string",
          "description": "Album the track belongs to."
        },
        "vibe": {
          "type": "string",
          "description": "The vibe or playlist category for the track.",
          "enum": ["Chipirón Selects", "Bavarian Beats", "Fiesta Latino", "Russian Lo-Fi"]
        },
        "lyrics": {
            "type": "array",
            "description": "Array of lyric objects with time and text.",
            "items": {
                "type": "object",
                "properties": {
                    "time": { "type": "number", "description": "Time in seconds" },
                    "text": { "type": "string", "description": "Lyric line" }
                },
                "required": ["time", "text"]
            }
        }
      },
      "required": [
        "title",
        "artist",
        "duration",
        "imageUrl",
        "audioUrl",
        "album",
        "vibe"
      ]
    },
    "Article": {
      "title": "Article",
      "type": "object",
      "description": "A satirical article for the premium section.",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageAlt": { "type": "string" },
        "teaser": { "type": "string" },
        "content": { "type": "string" },
        "readTime": { "type": "number", "description": "Reading time in minutes" },
        "publishedDate": { "type": "string", "format": "date-time" },
        "isFree": { "type": "boolean" }
      },
      "required": ["title", "slug", "category", "imageUrl", "teaser", "content", "readTime", "publishedDate", "isFree"]
    },
    "LandingPage": {
      "title": "Landing Page",
      "type": "object",
      "description": "A standalone landing page with custom HTML, CSS, and JS.",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "htmlContent": { "type": "string" },
        "cssContent": { "type": "string" },
        "jsContent": { "type": "string" }
      },
      "required": ["slug", "title"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/CHIPIRONES/music/tracks/{trackId}": {
      "schema": {
        "$ref": "#/entities/Track"
      },
      "description": "Collection of music tracks. Accessible only to authenticated admins for management."
    },
    "/articles/{articleId}": {
      "schema": {
        "$ref": "#/entities/Article"
      },
      "description": "Collection of premium satire articles."
    },
    "/landing_pages/{lpId}": {
      "schema": {
        "$ref": "#/entities/LandingPage"
      },
      "description": "Collection of standalone landing pages."
    }
  }
}
